# Backend API
API_BASE_URL=http://localhost:5000/api
SCHEDULER_API_KEY=change_this_to_a_long_random_secret_too

# Runs the daily check at this hour (24h, server local time)
DAILY_CHECK_HOUR=8
DAILY_CHECK_MINUTE=0

# Twilio (SMS + WhatsApp) - leave blank to disable and just log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=maintenance-alerts@example.com

# Owner contact (also gets a copy of every reminder, per spec)
OWNER_EMAIL=owner@example.com
OWNER_PHONE=
